// Mẫu gửi alert cho Signals Trader568VN.
// Dán phần dưới vào cuối chỉ báo/chiến lược của bạn, rồi thay các biến
// longEntry, shortEntry, slPrice, tpPrice... bằng điều kiện thật của bạn.
//
// Trên TradingView: Tạo Alert -> Điều kiện: chỉ báo này -> "Any alert() function call"
// -> Thông báo: bật Webhook URL = https://<worker>.workers.dev/webhook?key=<WEBHOOK_KEY>
// -> Để trống ô Message (nội dung do alert() bên dưới gửi).

//@version=5
// strategyId phải là một trong: ema | don | rsi (khớp với cột trên terminal)
strategyId = input.string("ema", "Mã chiến lược trên terminal", options = ["ema", "don", "rsi"])

f_num(v) => na(v) ? "null" : str.tostring(v, format.mintick)

f_send(string ev, string side, float price, float sl, float tp, string tradeId) =>
    msg = '{"strategy":"' + strategyId + '"' +
          ',"symbol":"' + syminfo.tickerid + '"' +
          ',"event":"' + ev + '"' +
          ',"side":"' + side + '"' +
          ',"price":' + f_num(price) +
          ',"sl":' + f_num(sl) +
          ',"tp":' + f_num(tp) +
          ',"id":"' + tradeId + '"' +
          ',"time":' + str.tostring(timenow) + '}'
    alert(msg, alert.freq_once_per_bar_close)

